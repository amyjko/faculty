ExpiresActive On
ExpiresDefault "access"
Options -Multiviews -Indexes

# Support cache manifest for the Budget app.
AddType text/cache-manifest .manifest

# Rewrite any non-existent files and directories to the index.html file, allowing
# our single page web app to do the routing on the front end.

# Turn the rewrite engine on.
RewriteEngine On

# Set the path to prepend to all rewrites.
RewriteBase /ajko

# Rewrite any http requests to https
RewriteCond %{HTTPS} off
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# If we're processing index.html, leave it alone and stop.
RewriteRule ^index\.html$ - [L] 

# If we're retrieving a data file, leave it alone and stop.
RewriteRule ^data/.*$ - [L] 

# Need an explicit rule to redirect the books directory to the app, otherwise we get the Apache directory listing.
# But we don't want to match anything inside the directory since we don't use the app for the books.
# Moreover, the redirect rule breaks the relative paths in index.html, so we need to explicitly
# rewrite the broken relative paths that are requested.
RewriteRule ^books/?$ books.html [L]

# Redirect any non-directory requests to the name without a trailing slash to avoid resolving to directory listings.
# The rule below will append .html to it.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*?)/$ $1 [R=301,L]

# Append .html to any requests with or without a trailing slash that resolve to a file with .html.
#
# The lookahead is what keeps this from looping. Apache stops its directory walk
# at the first component that isn't a directory, so /publications/books arrives
# here as REQUEST_FILENAME=.../publications with PATH_INFO=/books. The condition
# then sees publications.html, rewrites to publications/books.html, and that
# resolves the same way and matches again, recursing until Apache gives up with a
# 500. Refusing to append to a path that already ends in .html stops it after one
# pass, and the rule below then answers 404. The guard has to be in the pattern
# rather than a condition, because the pattern is matched against the current
# path, which is the only thing that changes between passes.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(?!.*\.html$)(.*)$ $1.html [L,QSA]

# The site root is the home page. This has to be said explicitly, because the
# request resolves to the directory rather than to a file, so the rule below
# would otherwise decide the home page doesn't exist.
RewriteRule ^$ index.html [L,QSA]

# Anything left doesn't exist. Answer 404 and let the ErrorDocument below render
# the app's own not-found page, rather than handing back index.html with a 200 --
# which quietly served the home page for every mistyped or stale URL, telling
# readers nothing was wrong and telling crawlers the page was real.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule (.*) - [R=404,L]

# The prerendered not-found page: the site's usual navigation, with an
# explanation in the body. Built from src/routes/(app)/404/+page.svelte.
ErrorDocument 404 /ajko/404.html